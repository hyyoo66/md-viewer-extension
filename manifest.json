{
  "manifest_version": 3,
  "name": "MD 뷰어 → PDF / Word",
  "version": "1.5.4",
  "description": "로컬 .md 파일을 열면 PDF 형태로 미리보고, PDF 또는 Word(.docx)로 저장합니다. F5로 다시 불러와도 보던 위치가 유지됩니다.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "MD 뷰어 설정 / 파일 열기",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["webNavigation"],
  "host_permissions": ["file:///*"]
}
